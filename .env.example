# Copy this file to .env and fill in your own values. Never commit .env.

# Anthropic SDK key, used via OpenRouter (https://openrouter.ai)
OPENROUTER_API_KEY=sk-or-your-key-here

# Postgres + pgvector (Docker container, default port 5433)
DB_HOST=localhost
DB_PORT=5433
DB_NAME=ragdb
DB_USER=postgres
DB_PASSWORD=ragpass
